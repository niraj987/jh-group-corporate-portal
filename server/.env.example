# JH Group Server Environment Configuration
PORT=5000
NODE_ENV=development

# Optional: MongoDB Connection String (e.g. MongoDB Atlas or local mongodb://localhost:27017/jh_group)
# If omitted, the server operates seamlessly with local JSON storage in server/data/contacts.json
MONGO_URI=mongodb://localhost:27017/jh_group

# Python Microservice URL
PYTHON_SERVICE_URL=http://localhost:8000
